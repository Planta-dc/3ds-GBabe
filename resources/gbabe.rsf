# makerom ROM spec for GBabe's .cia build.
#
# Placeholders of the form APP_XXX are substituted from the -DAPP_XXX=VALUE flags
# in the `cia` target of the top-level Makefile. Only the permissions this emulator
# actually uses are enabled: the SD card (ROMs, saves, config), the GPU's
# framebuffer mapping, HID input and CSND audio.
#
# Loosely based on the RSF templates used by TricksterGuy/3ds-template and
# SlinkyPotato/3DSBuildTemplate, trimmed down.

BasicInfo:
  Title                   : $(APP_TITLE)
  ProductCode             : $(APP_PRODUCT_CODE)
  Logo                    : Homebrew # Homebrew / Nintendo / Licensed / Distributed / iQue

TitleInfo:
  Category                : Application
  UniqueId                : $(APP_UNIQUE_ID)

Option:
  UseOnSD                 : true   # install to the SD card
  FreeProductCode         : true   # no retail product code needed
  MediaFootPadding        : false
  EnableCrypt             : false  # unsigned homebrew
  EnableCompress          : true

AccessControlInfo:
  CoreVersion             : 2
  DescVersion             : 2

  # Minimum kernel version: 4.5.0
  ReleaseKernelMajor      : "02"
  ReleaseKernelMinor      : "33"

  UseExtSaveData          : false

  # FS:USER archive access. DirectSdmc is read, DirectSdmcWrite lets GBabe save
  # cartridge RAM and config.cfg back to the SD card.
  FileSystemAccess:
   - CategoryFileSystemTool
   - DirectSdmc
   - DirectSdmcWrite

  # Process settings
  MemoryType              : Application
  SystemMode              : 64MB
  IdealProcessor          : 0
  AffinityMask            : 1
  Priority                : 16
  MaxCpu                  : 0x9E
  HandleTableSize         : 0x200
  DisableDebug            : false
  EnableForceDebug        : false
  CanWriteSharedPage      : true
  CanUsePrivilegedPriority: false
  CanUseNonAlphabetAndNumber: true
  PermitMainFunctionArgument: true
  CanShareDeviceMemory    : true
  RunnableOnSleep         : false
  SpecialMemoryArrange    : true

  # New3DS-only settings. With SystemModeExt: Legacy the title still runs on an
  # Old 3DS, where these are ignored.
  SystemModeExt           : Legacy
  CpuSpeed                : 804MHz
  EnableL2Cache           : true
  CanAccessCore2          : true

  # VRAM is mapped read-only: gfxGetFramebuffer() writes to the framebuffers
  # through this window.
  MemoryMapping:
   - 1f000000-1f5fffff:r

  SystemCallAccess:
    ControlMemory: 1
    QueryMemory: 2
    ExitProcess: 3
    GetProcessAffinityMask: 4
    SetProcessAffinityMask: 5
    GetProcessIdealProcessor: 6
    SetProcessIdealProcessor: 7
    CreateThread: 8
    ExitThread: 9
    SleepThread: 10
    GetThreadPriority: 11
    SetThreadPriority: 12
    GetThreadAffinityMask: 13
    SetThreadAffinityMask: 14
    GetThreadIdealProcessor: 15
    SetThreadIdealProcessor: 16
    GetCurrentProcessorNumber: 17
    Run: 18
    CreateMutex: 19
    ReleaseMutex: 20
    CreateSemaphore: 21
    ReleaseSemaphore: 22
    CreateEvent: 23
    SignalEvent: 24
    ClearEvent: 25
    CreateTimer: 26
    SetTimer: 27
    CancelTimer: 28
    ClearTimer: 29
    CreateMemoryBlock: 30
    MapMemoryBlock: 31
    UnmapMemoryBlock: 32
    CreateAddressArbiter: 33
    ArbitrateAddress: 34
    CloseHandle: 35
    WaitSynchronization1: 36
    WaitSynchronizationN: 37
    DuplicateHandle: 39
    GetSystemTick: 40
    GetHandleInfo: 41
    GetSystemInfo: 42
    GetProcessInfo: 43
    GetThreadInfo: 44
    ConnectToPort: 45
    SendSyncRequest1: 46
    SendSyncRequest2: 47
    SendSyncRequest3: 48
    SendSyncRequest4: 49
    SendSyncRequest: 50
    GetProcessId: 53
    GetProcessIdOfThread: 54
    GetThreadId: 55
    GetResourceLimit: 56
    GetResourceLimitLimitValues: 57
    GetResourceLimitCurrentValues: 58
    GetThreadContext: 59
    Break: 60
    OutputDebugString: 61
    CreatePort: 71
    CreateSessionToPort: 72
    CreateSession: 73
    AcceptSession: 74
    ReplyAndReceive1: 75
    ReplyAndReceive2: 76
    ReplyAndReceive3: 77
    ReplyAndReceive4: 78
    ReplyAndReceive: 79
    BindInterrupt: 80
    UnbindInterrupt: 81
    InvalidateProcessDataCache: 82
    StoreProcessDataCache: 83
    FlushProcessDataCache: 84
    ControlProcessMemory: 112
    MapProcessMemory: 113
    UnmapProcessMemory: 114
    Backdoor: 123

  # Services GBabe uses. csnd:SND is the audio backend (see source/audio.c),
  # fs:USER the SD card, gsp::Gpu the framebuffers, hid:USER the buttons.
  ServiceAccessControl:
   - APT:U
   - cfg:nor
   - cfg:u
   - csnd:SND
   - fs:USER
   - gsp::Gpu
   - hid:USER
   - ir:rst
   - ir:u
   - ir:USER
   - mic:u
   - ndm:u
   - ptm:sysm
   - ptm:u
   - pxi:dev

SystemControlInfo:
  SaveDataSize            : 0KB      # save RAM lives on the SD card
  RemasterVersion         : 2
  StackSize               : 0x40000

  Dependency:
    ac: 0x0004013000002402
    am: 0x0004013000001502
    cfg: 0x0004013000001702
    codec: 0x0004013000001802
    csnd: 0x0004013000002702
    dsp: 0x0004013000001a02
    gpio: 0x0004013000001b02
    gsp: 0x0004013000001c02
    hid: 0x0004013000001d02
    i2c: 0x0004013000001e02
    ir: 0x0004013000003302
    mcu: 0x0004013000001f02
    mic: 0x0004013000002002
    ndm: 0x0004013000002b02
    pdn: 0x0004013000002102
    ps: 0x0004013000003102
    ptm: 0x0004013000002202
    ro: 0x0004013000003702
    spi: 0x0004013000002302
